# ── CARTO basemap ──
# Key used by the Leaflet tile layer in src/components/ui/Map.tsx.
# Copy this file to .env.local and paste your real key there (.env.local is gitignored).
# If left empty, the map falls back to CARTO's keyless public tile endpoint.
NEXT_PUBLIC_CARTO_API_KEY=

# Set automatically by the Electron build; normally leave unset for web dev.
# GEORANKER_IS_ELECTRON=1
